Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Two GitHub accounts, selected by host alias (the full runbook lives
# off-repo — see the cheat sheet in ~/Desktop / Documents).
# The IdentityFile lines are PUBLIC keys — with IdentitiesOnly they tell
# the 1Password agent which key to offer; the private halves live in
# 1Password, never on disk or in this repo.

# kitsully — remotes spelled personal:owner/repo.git. Auth uses the same
# key that signs commits ("Personal RSA" in 1Password).
Host personal
	HostName github.com
	User git
	IdentityFile ~/.ssh/git_signing_key.pub
	IdentitiesOnly yes

# ksullivanDW — remotes spelled work:owner/repo.git
Host work
	HostName github.com
	User git
	IdentityFile ~/.ssh/github-work.pub
	IdentitiesOnly yes

# plain git@github.com: remotes default to the work account — that's what
# every DriveWealth repo uses
Host github.com
	User git
	IdentityFile ~/.ssh/github-work.pub
	IdentitiesOnly yes

# internal work server (key in 1Password: "Internal server RSA")
Host 10.5.12.151
	IdentityFile ~/.ssh/internal-server.pub
	IdentitiesOnly yes
