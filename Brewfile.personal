# Personal-machine packages — installed by: ./setup.sh mac  (default profile)
#
# Deliberately NOT installed on a work machine. Reasons, by group:
#   - personal licenses / subscriptions that don't cover corporate use
#   - personal data (journals, notes, tasks) that shouldn't land on a work device
#   - Mac App Store apps, which require signing a personal Apple ID into the machine
#   - redundant editors / git GUIs

# === CLI Tools ===
brew "doctl"                 # personal DigitalOcean account
brew "heroku"                # personal Heroku account
brew "mas"                   # Mac App Store CLI — only needed for the mas entries below

# === Cask Apps ===
cask "airbuddy"              # personal AirPods/device battery HUD
cask "bbedit"                # personal license; redundant with VS Code / nvim
cask "chatgpt"               # check employer's approved-AI-tools policy before adding at work
cask "claude"                # check employer's approved-AI-tools policy before adding at work
cask "docker-desktop"        # paid subscription required for larger orgs — see Brewfile.work
cask "github"                # redundant with gh CLI
cask "hazel"                 # personal license; automates personal file trees
cask "imazing"               # personal iOS device backups
cask "keyboard-maestro"      # personal license
cask "microsoft-edge"        # redundant browser
cask "microsoft-excel"       # work provisions Office via its own M365 tenant
cask "microsoft-powerpoint"  # work provisions Office via its own M365 tenant
cask "microsoft-word"        # work provisions Office via its own M365 tenant
cask "obsidian"              # personal vault sync
cask "setapp"                # personal subscription
cask "soulver"               # personal license
cask "spotify"
cask "steam"                 # games — usually against corporate acceptable-use policy
cask "sublime-merge"         # personal license; redundant git GUI
cask "sublime-text"          # personal license; redundant editor
cask "superduper"            # disk cloning — cloning a managed work Mac is usually prohibited
cask "textexpander"          # personal subscription
cask "tower"                 # personal license; redundant git GUI
cask "transmit"              # personal license

# === Mac App Store ===
# All of these require a personal Apple ID signed into the machine.
mas "1Blocker", id: 1365531024
mas "1Password for Safari", id: 1569813296
