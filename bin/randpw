#!/bin/bash
# Print a random password: letters and digits, paste-safe anywhere.
#   randpw        -> 24 characters
#   randpw 40     -> 40 characters
#   randpw -s     -> include symbols
# Targets bash 3.2 (the macOS system bash).

set -uo pipefail

chars='A-Za-z0-9'
length=24

for arg in "$@"; do
    case "$arg" in
        -s) chars='A-Za-z0-9!@#$%^&*()_+=-' ;;
        -h|--help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;;
        *[!0-9]*) echo "usage: randpw [-s] [length]" >&2; exit 1 ;;
        *) length="$arg" ;;
    esac
done

# LC_ALL=C keeps tr byte-oriented; head caps the urandom read.
LC_ALL=C tr -dc "$chars" < /dev/urandom | head -c "$length"
echo
